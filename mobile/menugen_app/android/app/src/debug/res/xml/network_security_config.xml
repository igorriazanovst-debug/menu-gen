<?xml version="1.0" encoding="utf-8"?>
<!-- MG_RELEASE: послабления ТОЛЬКО для отладочных сборок.
     Дев-сервер и эмулятор работают по открытому HTTP, и без этого списка
     приложение к ним не подключится. В релизе действует строгий конфиг из
     src/main — открытый HTTP там запрещён целиком. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">31.192.110.121</domain>
        <domain includeSubdomains="true">192.168.68.60</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
