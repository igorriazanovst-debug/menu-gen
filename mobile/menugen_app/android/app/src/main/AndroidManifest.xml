<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- MG_SELFUPDATE: передать скачанное обновление системному установщику.
         Само приложение установить его не может — тихая установка доступна
         только системным приложениям, — но обязано иметь право попросить.

         MG_STOREPERM: разрешение вырезается из магазинной сборки.

         Раньше здесь стояло, что магазинную мы «собираем без апдейтера», и это
         было верно только про КОД: флаг SELF_UPDATE в AAB не передаётся. А сам
         манифест общий, поэтому разрешение уезжало и в магазин. RuStore смотрит
         список разрешений, а не код, и отклонил 1.0.2 именно за него.

         Строку удаляет build.gradle, когда сборку просят быть магазинной, —
         см. там же, почему не плейсхолдером и не флавором. Держать её ОДНОЙ
         строкой обязательно: удаление построчное, и разбитый на несколько
         строк элемент оно пропустит. Проверку, что в AAB разрешения нет, а в
         APK оно есть, делает android_release.yml до выкладки артефактов. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- MG_WEIGHREMIND: ежедневное напоминание взвеситься.
         POST_NOTIFICATIONS — с Android 13 без него уведомления не показываются
         вовсе, причём молча. RECEIVE_BOOT_COMPLETED — чтобы напоминание пережило
         перезагрузку: система снимает отложенные показы, и плагин ставит их
         заново по своему приёмнику. Разрешение на точные будильники намеренно
         НЕ берём: оно требует объяснения магазину, а напоминанию взвеситься
         минута туда-сюда безразлична. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- MG_MEDIAPERM: доступ к чужим фото, видео и музыке приложению не нужен.

         Google Play не принял сборку: «Все разработчики, запрашивающие доступ
         к разрешениям для фото и видео, должны сообщить нам об основных
         функциях своего приложения». Заполнять эту декларацию было бы неправдой
         — разрешения нам не нужны вовсе.

         Откуда они взялись: их объявляет в своём манифесте пакет open_filex, и
         при слиянии манифестов они приезжают к нам. Мы этим пакетом делаем
         ровно одно — отдаём скачанный APK системному установщику
         (update_service.dart). Файл лежит в кэше приложения, а для путей внутри
         своего каталога сам плагин разрешений не спрашивает: см. его
         pathRequiresPermission(). То есть разрешения объявлены и никогда не
         используются.

         Прикрепление фото блюда («Я приготовил») тут ни при чём: image_picker
         не объявляет ни одного разрешения — он получает файл через системный
         выбор, по content-ссылке, и права на чужие файлы ему не нужны.

         tools:node="remove" — единственный способ убрать чужое объявление:
         строку в чужом пакете не удалить, а наш манифест указывает
         слиянию выбросить этот узел. Разрешения убираются в ОБЕИХ сборках, и
         в магазинной, и в сайтовой: раз ими никто не пользуется, разводить
         сборки незачем.

         Что это НЕ ломает (проверено по исходникам пакетов, а не по памяти):
         выбор фото из галереи и съёмку камерой — они идут через image_picker;
         самообновление с сайта — путь к APK внутри каталога приложения. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <!-- MG_TGLINK: без этого блока подтверждение телефона упиралось в «не удалось
         открыть мессенджер».

         С Android 11 приложение по умолчанию не видит, какие ещё приложения стоят
         на устройстве. Поэтому canLaunchUrl() для https-ссылки отвечает «нельзя»
         даже тогда, когда и Telegram, и браузер установлены — не потому, что
         открыть нечем, а потому, что нам не дали посмотреть. Перечисляем
         намерения, которые нам действительно нужны: открыть ссылку и написать
         письмо. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <!-- Telegram и MAX по своим схемам: если приложение стоит, ссылка
             откроется прямо в нём, минуя браузер. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tg"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="max"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
    <!-- MG_APPICON: android:label — короткая подпись под иконкой, лаунчер
         обрезает примерно после 12 символов. Полное название «MenuGen Platform»
         показывается внутри приложения (экран входа).
         MG_DEVBUILD: сама строка задаётся в build.gradle (resValue), чтобы
         отладочная сборка называлась «MenuGen dev» и её было видно в лаунчере
         рядом с магазинной. -->
    <!-- MG_SDK36: предиктивный «назад».

         С targetSdk 36 система больше не вызывает onBackPressed, а движок
         Flutter опирается на него, пока ему явно не разрешат новый механизм.
         Без этого флага кнопка «назад» перестала бы двигать навигацию внутри
         приложения — молча и на всех экранах сразу.

         Флаг ставится в true, а не в false: false — это временное отключение
         нового поведения, и он перестанет работать в следующих версиях
         Android. Своих перехватов «назад» в приложении нет (ни WillPopScope,
         ни PopScope), так что переносить нечего. -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- MG_VERIFYDEEPLINK: возврат в приложение после подтверждения
                 e-mail на веб-странице: menugen://verified?email=…
                 Своя схема, а не https: App Links сверяют SHA-256 отпечаток
                 подписи, а release пока подписывается debug-ключом, который в
                 CI генерируется заново каждую сборку. Когда появятся свой
                 applicationId и постоянный keystore — сюда добавится второй
                 intent-filter на https + assetlinks.json, и ссылка из письма
                 будет открывать приложение напрямую. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="menugen" android:host="verified"/>
                <!-- MG_PAYRELIABLE: возврат с оплаты (ЮKassa принимает только
                     http(s) в return_url, поэтому возвращает через сайт). -->
                <data android:scheme="menugen" android:host="payment"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
</manifest>