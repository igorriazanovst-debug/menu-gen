# MenuGen web (CRA). Скопируйте в .env и подставьте адрес API.
#
# Рекомендуется относительный путь — фронт и API на одном домене (menugen.ru),
# тогда смена сервера/домена не требует пересборки фронта:
#   REACT_APP_API_BASE_URL=/api/v1
#
# Абсолютный URL нужен, только если API на другом хосте:
#   REACT_APP_API_BASE_URL=https://menugen.ru/api/v1
REACT_APP_API_BASE_URL=/api/v1
