# MG_DEVMIRROR — обязательный хвост .env на dev-сервере.
#
# Эти строки проверяет restore_dev.sh ДО заливки боевых данных. Без них скрипт
# останавливается: копия прода в контуре с рабочей почтой и боевыми ключами
# кассы — это письма живым людям и запросы в настоящую ЮKassa.
#
# Дописать в конец /opt/menugen/.env на dev (значения ниже перекрывают те же
# ключи, заданные выше по файлу) и перезапустить backend.

# Пометка контура. Значение по умолчанию в коде — prod, поэтому сервер без этой
# строки считается боевым и sanitize_dev на нём работать откажется.
MENUGEN_ENV=dev

# Почта — в лог контейнера, наружу ничего не уходит.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Оплата — заглушкой, боевые реквизиты кассы пустые.
PAYMENTS_STUB=True
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Боты мессенджеров молчат: в копии прода лежат настоящие chat_id.
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
